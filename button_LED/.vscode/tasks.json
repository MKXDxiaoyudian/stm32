{
  "version": "2.0.0",
  "tasks": [
    {
      // 配置 Debug（生成 build/Debug）。改了 CMakeLists.txt 或新增源文件后必须跑
      "label": "Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "Debug"
      ],
      "problemMatcher": []
    },
    {
      // 配置 Release（生成 build/Release），产物是 build/Release/button_LED.elf
      "label": "Configure Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "Release"
      ],
      "problemMatcher": []
    },
    {
      // 默认构建（⌘⇧B）。2026-10-02 改动：先自动 Configure 再 Build，
      // 这样新 clone 下来（没有 build/ 目录）直接 ⌘⇧B 就能过，不用回终端敲 configure
      "label": "Build",
      "type": "shell",
      "dependsOn": [
        "Configure Release"
      ],
      "dependsOrder": "sequence",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      // 调试用的 Debug 构建（F5 会自动先跑这个，见 launch.json 的 preLaunchTask）
      "label": "Build Debug",
      "type": "shell",
      "dependsOn": [
        "Configure Debug"
      ],
      "dependsOrder": "sequence",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Debug"
      ],
      "problemMatcher": []
    },
    {
      // 万念俱灰时用：删掉 build/ 从零配置再编译（改工程名、换工具链、CMake 缓存出邪门问题时）
      "label": "从零重建（删 build 重配）",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf build && cmake --preset Debug && cmake --preset Release && cmake --build build/Release"
      ],
      "problemMatcher": []
    },
    {
      // ⭐ 烧录：一键 = 先编译 Release，再用 DAP 写入
      "label": "DAPLink Flash",
      "type": "shell",
      "dependsOn": [
        "Build"
      ],
      "dependsOrder": "sequence",
      "command": "openocd",
      "args": [
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/stm32f1x.cfg",
        "-c",
        "program ${workspaceFolder}/build/Release/button_LED.elf verify reset exit"
      ],
      "problemMatcher": []
    },
    {
      // 只连接、不烧写：用来确认 DAP 插好了、芯片认到了
      "label": "DAPLink 探测（只连不烧）",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/stm32f1x.cfg",
        "-c",
        "init; exit"
      ],
      "problemMatcher": []
    }
  ]
}
